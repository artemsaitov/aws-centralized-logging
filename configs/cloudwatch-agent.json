{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/messages",
            "log_group_name": "/centralized-logging/ec2/system",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/myapp/application.log",
            "log_group_name": "/centralized-logging/ec2/application",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  }
}